    <SolidColorBrush x:Key="DataGridRowSelectedForegroundBrush" Color="#000000" />
    <SolidColorBrush x:Key="DataGridHeaderBackgroundBrush" Color="#F0F0F0" />
    <SolidColorBrush x:Key="DataGridHeaderForegroundBrush" Color="#1A1A1A" />
    <SolidColorBrush x:Key="DataGridGridLinesBrush" Color="#E3E3E3" />
    <SolidColorBrush x:Key="ControllerDeadRowBackgroundBrush" Color="#EDEFF5" />
    <SolidColorBrush x:Key="BarrelPhaseRowBackgroundBrush" Color="#FFF3D9" />

    <SolidColorBrush x:Key="ButtonBackgroundBrush" Color="#EAEAEA" />
    <SolidColorBrush x:Key="ButtonForegroundBrush" Color="#1A1A1A" />
    <SolidColorBrush x:Key="ButtonBorderBrush" Color="#C6C6C6" />

</ResourceDictionary>
