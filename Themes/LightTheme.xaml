<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="PrimaryTextBrush" Color="#1A1A1A" />
    <SolidColorBrush x:Key="SecondaryTextBrush" Color="#666666" />
    <SolidColorBrush x:Key="BorderBrush" Color="#DDDDDD" />

    <SolidColorBrush x:Key="DataGridBackgroundBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="DataGridRowBackgroundBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="DataGridAlternatingRowBackgroundBrush" Color="#F5F5F5" />
